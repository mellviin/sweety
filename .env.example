POSTGRES_PASSWORD=replace-with-postgres-password
APP_DB_PASSWORD=replace-with-app-db-password
MIGRATE_DB_PASSWORD=replace-with-migration-db-password
DATABASE_URL=postgresql://sweety_app:replace-with-app-db-password@localhost:5432/sweety
MIGRATION_DATABASE_URL=postgresql://sweety_migrate:replace-with-migration-db-password@localhost:5432/sweety
TEST_DATABASE_URL=postgresql://sweety_app:replace-with-app-db-password@localhost:5432/sweety_test
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d
NODE_ENV=development
PORT=3000
CLIENT_URL=http://localhost:5173
TRUST_PROXY=false
APP_TIMEZONE=Asia/Kolkata
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_ENABLED=false
GLOBAL_RATE_LIMIT_MAX=300
GLOBAL_RATE_LIMIT_WINDOW_MS=900000
LOGIN_FAILURE_RATE_LIMIT_MAX=5
LOGIN_FAILURE_RATE_LIMIT_WINDOW_MS=900000
READING_WRITE_RATE_LIMIT_MAX=60
READING_WRITE_RATE_LIMIT_WINDOW_MS=900000
